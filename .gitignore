# Rust build artifacts
/target/

# Cargo cache (used by devcontainer builds)
/.cargo-cache/

# Cargo tools installed for local scanner runs (e.g. cargo-deny,
# cargo-audit). Kept outside the shared registry cache so we can
# install tooling without needing root.
/.cargo-tools/

# IDE
.idea/
*.iml
# Ignore VS Code settings, but keep the review tracking state (see
# shakenfist/development docs/code-review-tracking.md).
.vscode/*
!.vscode/*.weaudit
!.vscode/*.weaudit-shas.json
!.vscode/review-scope.toml

# OS
.DS_Store
Thumbs.db

# Test images
/testdata/

# Latency measurement output
latency.csv

# Python bytecode caches (e.g. examples/*.py compiled by the
# operator running them locally).
__pycache__/
*.pyc
